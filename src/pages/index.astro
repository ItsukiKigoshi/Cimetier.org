---
import { Icon } from "astro-icon/components";

import Awards from "@/components/Awards.astro";
import Certificates from "@/components/Certificates.astro";
import Education from "@/components/Education.astro";
import Experiences from "@/components/Experiences.astro";
import Featured from "@/components/Featured.astro";
import Location from "@/components/Location.astro";
import Profile from "@/components/Profile.astro";
import Works from "@/components/Works.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title='木越 斎 / Itsuki "Cimetier" Kigoshi'>
    <main class="mx-auto w-full max-w-xl px-4">
        <!-- First View Section -->
        <section
            class="flex min-h-dvh flex-col items-center justify-between py-6"
        >
            <header class="w-full">
                <Location/>
            </header>
            
            <!-- Main Profile -->
            <Profile />

            <!-- Bottom Container: Scroll Chevron + Footer Info -->
            <footer class="flex w-full flex-col items-center gap-4 text-center">
                <!-- Docs / GitLab / Legal / GPG Component -->
                <nav class="flex flex-col items-center gap-1.5 text-[12px]">
                    <span class="flex items-center gap-3">
                        <a
                            href="https://docs.cimetier.org/"
                            class="underline opacity-80 hover:opacity-100"
                        >
                            Docs
                        </a>
                        <span class="opacity-40">/</span>
                        <a
                            href="https://gitlab.com/ItsukiKigoshi"
                            class="underline opacity-80 hover:opacity-100"
                        >
                            GitLab
                        </a>
                        <span class="opacity-40">/</span>
                        <a
                            href="/legal"
                            class="underline opacity-80 hover:opacity-100"
                        >
                            Legal
                        </a>
                        <span class="opacity-40">/</span>
                        <a
                            href="/itsukikigoshi.asc"
                            class="group inline-flex items-end gap-1 underline opacity-80 hover:opacity-100"
                        >
                            GPG Key
                            <Icon name="mdi:tray-arrow-down" class="h-4 w-4" />
                        </a>
                    </span>
                    <span class="flex items-center gap-1.5 px-2 py-0.5">
                        <Icon
                            name="mdi:fingerprint"
                            class="h-3 w-3 opacity-60"
                        />
                        <code
                            class="font-mono text-[10px] opacity-80 select-all"
                        >
                            5FEF A11E 52F0 AF96 960E 46B8 F555 5D33 934B 62B8
                        </code>
                    </span>
                </nav>

                <!-- Scroll Chevron -->
                <aside class="flex flex-col items-center gap-0.5">
                    <span
                        class="font-mono text-[10px] tracking-widest opacity-60"
                        >SCROLL</span
                    >
                    <Icon
                        name="mdi:chevron-down"
                        class="h-4 w-4 animate-bounce opacity-60"
                    />
                </aside>
            </footer>
        </section>

        <!-- Additional Content Section -->
        <article class="border-base-content/20 space-y-10 py-12">
            <Works />
            <Featured />
            <Education />
            <Experiences />
            <Certificates />
            <Awards />
        </article>
    </main>
</Layout>
