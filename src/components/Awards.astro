---
import { Icon } from "astro-icon/components";

const awards = [
  {
    title: "第5回 中・高等学校対抗交渉コンペティション 優勝 (2022年3月)",
    link: "https://sites.google.com/view/negocompetiton/past",
  },
];
---

<section>
  <h2 class="border-base-content/20 mb-2 border-b pb-1 font-bold">Awards</h2>
  <ul class="list-disc space-y-1 pl-5">
    {
      awards.map((award) => (
        <li>
          <span class="inline-flex items-center gap-1">
            {award.title}
            {award.link && (
              <a
                href={award.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon
                  name="mdi:open-in-new"
                  class="h-4 w-4 shrink-0"
                />
              </a>
            )}
          </span>
        </li>
      ))
    }
  </ul>
</section>