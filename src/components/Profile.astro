---
import { Icon } from "astro-icon/components";

import { Image } from "astro:assets";
import imgReference from "@/assets/profile.jpg";

import SocialLink from "@/components/SocialLink.astro";

const socialLinks = [
  {
    label: "Email",
    icon: "mdi:email",
    href: "mailto:itsukikigoshi@gmail.com",
  },
  {
    label: "GitHub",
    icon: "mdi:github",
    href: "https://www.github.com/itsukikigoshi",
  },
  {
    label: "GitLab",
    icon: "mdi:gitlab",
    href: "https://gitlab.com/ItsukiKigoshi",
  },
  {
    label: "Flickr",
    icon: "mdi:camera",
    href: "https://www.flickr.com/photos/202138941@N05/",
  },
  {
    label: "Zenn",
    icon: "zenn",
    href: "https://zenn.dev/itsukikigoshi",
  },
  {
    label: "Booklog",
    icon: "mdi:book-open-page-variant",
    href: "https://booklog.jp/users/itsukikigoshi",
  },
  {
    label: "IMDb",
    icon: "mdi:theaters",
    href: "https://www.imdb.com/user/ur163313033/",
  },
  {
    label: "YAMAP",
    icon: "mdi:landscape",
    href: "https://yamap.com/users/3971974",
  },
];
---

<section class="flex flex-col items-center text-center">
  <figure class="mb-4 overflow-hidden rounded-full">
    <Image
      src={imgReference}
      alt='Itsuki "Cimetier" Kigoshi'
      class="h-48 w-48 object-cover"
      loading="eager"
    />
  </figure>
  <h1 class="inline-flex items-center gap-2 text-xl font-bold">
    Itsuki <a
      href="https://lab.cimetier.org/"
      class="-rotate-7 text-sm font-light italic opacity-80 duration-300 hover:rotate-0 hover:text-xl hover:font-bold"
      >"<span class="underline">Cimetier</span>"</a
    > Kigoshi / 木越 斎
  </h1>
  <h2 class="my-3 text-sm opacity-100">ICU'27 (2004)</h2>
  <h3 class="mb-4 text-base">Astronomy, Contemporary Art, Climbing</h3>

  <nav class="gap-0.2 flex justify-center">
    {
      socialLinks.map((link) => (
        <SocialLink
          href={link.href}
          ariaLabel={link.label}
          iconName={link.icon}
        />
      ))
    }
  </nav>
</section>
