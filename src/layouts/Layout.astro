---
import "../styles/global.css";
import { Icon } from "astro-icon/components";

const { pathname } = Astro.url;
const currentPath = decodeURIComponent(pathname).replace(/\/$/, "") || "/";
const isHome = currentPath === "/";

const {
  title = '木越 斎 / Itsuki "Cimetier" Kigoshi',
  description = '木越 斎（きごし いつき、2004年9月25日-）は, 国際基督教大学で統計学を専攻する大学生です. Itsuki "Cimetier" Kigoshi is a unversity student studying statistics at ICU.',
  image = "https://cimetier.org/images/og-image.png",
} = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="flex min-h-dvh w-full flex-col justify-between">
    <slot />
    {
      !isHome && (
        <footer class="flex w-full flex-col items-center pb-6">
          <a
            href="/"
            class="group inline-flex items-center gap-1 font-medium underline opacity-60"
          >
            <Icon name="mdi:home" class="h-4 w-4" />
            Home
          </a>
        </footer>
      )
    }
  </body>
</html>